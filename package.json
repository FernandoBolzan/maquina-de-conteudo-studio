{
  "name": "maquina-de-conteudo",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Estúdio local de criação de conteúdo com Codex e Claude Code",
  "homepage": "https://www.fernandobolzan.com/maquina-de-conteudo",
  "desktopName": "maquina-de-conteudo-studio",
  "main": "dist/main/electron.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.main.json",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "lint": "eslint src",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "preview": "tsx scripts/preview.ts",
    "mobile": "tsx scripts/mobile.ts",
    "pack": "npm run build && electron-builder --linux dir --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:windows": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.maquinadeconteudo.studio",
    "productName": "Máquina de Conteúdo (Studio)",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "icon": "public/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "FernandoBolzan",
        "repo": "maquina-de-conteudo-studio",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Máquina de Conteúdo (Studio)",
      "syncDesktopName": true
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "A Máquina de Conteúdo usa o microfone para gravar a narração de cada cena no Modo Studio."
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": true
  }
}
